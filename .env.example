# ─────────────────────────────────────────────────────────────────
# Plataforma Tiago Alemão VET — Variáveis de Ambiente
# ─────────────────────────────────────────────────────────────────
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha cada valor abaixo
# 3. NUNCA commite o .env no git (já está no .gitignore)

# ── Supabase ──────────────────────────────────────────────────────
# Encontre em: supabase.com → projeto → Settings → API
VITE_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Apenas para Edge Functions (NUNCA no frontend) ────────────────
# Usado pelas supabase/functions/* via secrets do Supabase
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── ASA / Asaas (pagamentos) ──────────────────────────────────────
# Encontre em: asaas.com → Configurações → Integrações → API Keys
# Para testar: use a URL sandbox abaixo
# Para produção: troque por https://api.asaas.com/v3
ASAAS_API_KEY=$aact_...
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Token que você define — cadastre o MESMO valor no webhook do Asaas
ASAAS_WEBHOOK_TOKEN=escolha-uma-string-segura-aqui

# ── Email transacional (Resend) ───────────────────────────────────
# Crie conta gratuita em: resend.com
# Grátis até 3.000 emails/mês
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@tiagoedu.com.br

# ── Configurações da plataforma ───────────────────────────────────
PLATFORM_URL=https://app.tiagoedu.com.br
PLATFORM_NAME=Tiago Alemão VET

# ── Feature Flags ─────────────────────────────────────────────────
# false → Loja mostra "Em breve", sem checkout
# true  → Ativa checkout ASA completo (PIX, cartão, boleto)
# Mude para true no Netlify quando o ASA estiver configurado e testado
VITE_ENABLE_PAYMENTS=false
